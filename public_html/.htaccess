# gahk.dk on Hetzner Webhosting (Apache + mod_rewrite; Python through FastCGI and CGI).
#
# Installed into ~/public_html/ by every release, which overwrites the whole file except the LOCAL
# block below. Make every change here, in the repository, and let it release; a change made only on
# the server is lost at the next install. Only host-specific lines go in the LOCAL block on the server.
#
# Every page is a pre-rendered file; Apache serves those without starting Python. Whatever has no
# file (the sync API, the forms, the visit beacon, the calendar pass-through, redirects of old
# addresses and the 404 page) goes to the Flask app: through cgi-bin/gahk.fcgi, a persistent FastCGI
# process, except /api/update and large request bodies, which go to cgi-bin/gahk.cgi (CGI, one
# process per request). The server runs *.fcgi as FastCGI and *.cgi and *.py as CGI anywhere under
# public_html without any line here (verified 2026-11-12), so every other script is refused below.
# gahk_web/routing.py mirrors these rules for the development server; keep the two in step.
#
# [VERIFY ON HETZNER] marks what could not be tested before the site ran on the webhost. Every rule
# here runs end to end on a fake webhost in CI (Debian's Apache 2.4; DEPLOY.md section 13).

Options -Indexes -MultiViews
# Pages live at /faciliteter (no slash): never let Apache redirect a folder to its slashed form.
DirectorySlash Off
DirectoryIndex index.html
AddDefaultCharset utf-8
# Apache's own 404s (rare: most misses go to the app, which sends the same page).
ErrorDocument 404 /404.html

# Host-specific lines, edited on the server only (e.g. SetEnv GAHK_WEB_HOME /usr/home/<login>, which
# reaches gahk.cgi only, and only where scripts do not run through suEXEC). Every install keeps what stands between these two markers in the installed
# file (an empty block gets the release's). Keep the marker lines as they are.
#
# The CGI-only switch: remove the "# " in front of the RewriteRule below to send everything the app
# answers to gahk.cgi instead of the FastCGI process (should FastCGI misbehave). Slower (a Python
# start per request), but nothing else changes. Put the "# " back to return to FastCGI.
# BEGIN LOCAL
# RewriteRule ^ - [E=GAHK_CGI_ONLY:1]
# END LOCAL

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Canonical host and scheme: www.gahk.dk → gahk.dk, http → https ---------------------------
  # [VERIFY ON HETZNER] that %{HTTPS} is "on" behind Hetzner's TLS termination (no redirect loop);
  # it is where Apache terminates TLS itself (the fake webhost).
  # %{REQUEST_URI} is the decoded path, so no NE: mod_rewrite percent-encodes it again (a space or a
  # Danish letter in an old picture's name must not reach the Location header as it is).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- Never serve dot-files (.htaccess, .tmp-* files mid-write); certificates' .well-known is ok --
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # --- The two stubs in cgi-bin/ run only through the rewrites at the end of this file. Asked for
  # directly (/cgi-bin/gahk.fcgi/api/publish) they are refused: the app only ever sees the path the
  # browser sent, which is also the path intern signs. REDIRECT_STATUS is empty on the browser's own
  # request and set in the second round, after a rewrite below.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^cgi-bin(?:/|$) - [F,L]
  RewriteRule ^cgi-bin/gahk\.f?cgi(?:/|$) - [L]
  RewriteRule ^cgi-bin(?:/|$) - [F,L]

  # --- The intranet moved to intern.gahk.dk. 308 keeps the method and body (POSTs survive). They come
  # before the script refusal below, as the old wiki's addresses end in .php. ---
  # /intern/x and /nyintern/x keep their prefix: intern.gahk.dk/intern/x works on whatever runs
  # there, the old code (which serves /intern/…) and the new (which sends /intern/x on to /x itself,
  # keeping the query and the method).
  RewriteRule ^((?:intern|nyintern|admin|django-admin|wiki)(?:/.*)?)$ https://intern.gahk.dk/$1 [R=308,L]
  RewriteRule ^((?:photo-album|media)/.*)$ https://intern.gahk.dk/$1 [R=308,L]
  # intern's health checks: /health (readiness) and /healthz (liveness), which a monitor may poll.
  RewriteRule ^health(z?)/?$ https://intern.gahk.dk/health$1 [R=308,L]
  RewriteRule ^(optagelse/(?:listansoegninger|eksport))/?$ https://intern.gahk.dk/$1 [R=308,L]
  RewriteRule ^(optagelse/(?:showAnsoegning|setasreceived|kasser)/.+)$ https://intern.gahk.dk/$1 [R=308,L]

  # --- No other script runs: the server would run any *.py, *.cgi or *.fcgi under public_html (and,
  # as Apache maps handlers by every extension, a.cgi.jpg too), whatever the case of its name. The
  # same for what the host may map to PHP, Perl or server-side includes. After the intranet redirects,
  # which run nothing: /wiki/index.php?title=… and /wiki/load.php?… must reach intern.gahk.dk. ---
  RewriteRule (?:^|/)[^/]*\.(?:py|cgi|fcgi|php\d?|phtml|phar|pl|shtml)(?:[./]|$) - [F,L,NC]

  # --- The oldest image addresses. The app then sends /static/legacy/image/... on to the
  # picture's /billeder/ address (from the published snapshot), or answers 404.
  RewriteRule ^public/image/(.+)$ /static/legacy/image/$1 [R=301,L]

  # --- Icons browsers ask for at the root, and the old site's logo at its old addresses (the logo
  # and favicon of every page there, plain and with Django's content hash; others may link it) ---
  RewriteRule ^favicon\.ico$ static/favicon.ico [L]
  RewriteRule ^apple-touch-icon(?:-precomposed)?\.png$ static/img/apple-touch-icon.png [L]
  RewriteRule ^static/legacy/image/elements/lamassu(?:\.b8dc291a4e43)?\.svg$ static/img/lamassu.svg [L]

  # --- Files that exist are served as they are (GET/HEAD only: a POST must reach the app) ---
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # --- Pre-rendered pages: /faciliteter and /faciliteter/ both serve faciliteter/index.html ---
  # The trailing-slash form also finds the file ("…/faciliteter//index.html"; the fake webhost).
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*?)/?$ $1/index.html [L]

  # --- The old intranet's static files (its app manifest and icons, its build, the pictures its
  # templates show): intern.gahk.dk serves them at the same path. Only what has no file here, so
  # this site's own files of the same names (static/icons/icon-192x192.png) win. ---
  RewriteRule ^(static/(?:manifest\.json|icons/[^/]+|dist/.+|legacy/image/(?:elements|intern)/.+))$ https://intern.gahk.dk/$1 [R=301,L]

  # --- Everything else: the Flask app, with the original path as PATH_INFO (the app reads
  # REQUEST_URI, the browser's own request line, which every rewrite keeps) ---
  # /api/update always goes to gahk.cgi: it runs the self-updater without importing the release,
  # so an update can repair a broken release, or a broken FastCGI process, from there.
  RewriteRule ^api/update$ cgi-bin/gahk.cgi/api/update [L,QSA]
  # Publishes and the nightly rebuild render the whole site after up to 30 s of picture variants:
  # longer than mod_fcgid waits for an answer (FcgidIOTimeout, 40 s by default), so they go to CGI.
  RewriteRule ^(api/(?:publish|rebuild))$ cgi-bin/gahk.cgi/$1 [L,QSA]
  # Bodies of 100 000 bytes and more (image uploads, publishes) go to gahk.cgi: mod_fcgid refuses
  # bodies over FcgidMaxRequestLen (128 KiB unless Hetzner raised it), which no .htaccess can change.
  RewriteCond %{HTTP:Content-Length} ^[0-9]{6,}$
  RewriteRule ^(.*)$ cgi-bin/gahk.cgi/$1 [L,QSA]
  # The CGI-only switch in the LOCAL block.
  RewriteCond %{ENV:GAHK_CGI_ONLY} =1
  RewriteRule ^(.*)$ cgi-bin/gahk.cgi/$1 [L,QSA]
  RewriteRule ^(.*)$ cgi-bin/gahk.fcgi/$1 [L,QSA]
</IfModule>

# --- Files that must never be served or run, whatever happens to the rules above ---
<FilesMatch "\.(?:ini|py|pyc|sql|cfg|toml|lock|log|bak|sh)$">
  Require all denied
</FilesMatch>

# --- Caching. Applies to files served from disk; the app sets its own headers. ---
# [VERIFY ON HETZNER] mod_headers and ap_expr <If> (Apache 2.4) are available in .htaccess (they work
# on the fake webhost; whether Hetzner loads mod_headers is its choice).
<IfModule mod_headers.c>
  # Pre-rendered pages: short, so an edit on intern shows within a minute.
  <If "%{REQUEST_FILENAME} =~ m#\.(?:html|xml|txt)$#">
    Header set Cache-Control "public, max-age=60"
  </If>
  # Pictures: the address carries the content hash, so they never change.
  <If "%{REQUEST_FILENAME} =~ m#/billeder/[0-9a-f]{16}/[^/]+$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Site assets with a content hash in the name (site.1a2b3c4d.css).
  <If "%{REQUEST_FILENAME} =~ m#/static/.+\.[0-9a-f]{8,}\.[a-z0-9]+$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Unhashed assets (fonts, push icons, favicon): a week.
  <If "%{REQUEST_FILENAME} =~ m#/static/(?:fonts|icons|img)/[^/]+$# || %{REQUEST_FILENAME} =~ m#/static/favicon\.ico$#">
    Header set Cache-Control "public, max-age=604800"
  </If>
  # Fonts: browsers fetch them with CORS. intern's preview shows this site's HTML on intern.gahk.dk,
  # which loads them from here, so any origin may have them (routing.FONT_RE).
  <If "%{REQUEST_FILENAME} =~ m#/static/fonts/[^/]+$#">
    Header set Access-Control-Allow-Origin "*"
  </If>
  # The self-removing service worker: browsers must always fetch it fresh.
  <If "%{REQUEST_FILENAME} =~ m#/sw\.js$#">
    Header set Cache-Control "no-cache"
  </If>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # [VERIFY ON HETZNER] only once https works for gahk.dk and www.gahk.dk (browsers remember it).
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript image/svg+xml
</IfModule>
